<Window x:Class="New7z.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="18,0,160,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image x:Name="BrandImage" Width="24" Height="24"/><TextBlock Text="New7z" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="208" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="True" SelectionChanged="NavigationChanged" IsTitleBarAutoPaddingEnabled="False">
   <NavigationView.MenuItems><NavigationViewItem Content="主页" Tag="home" Icon="Home" IsSelected="True"/><NavigationViewItem Content="压缩包" Tag="archive"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="任务中心" Tag="tasks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
   <Grid Margin="0,0,12,0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><InfoBar x:Name="Message" IsOpen="False" IsClosable="True" Margin="24,16,24,0"/><Grid x:Name="ContentHost" Grid.Row="1" Padding="32,24"/></Grid>
  </NavigationView>
  <Grid Grid.Row="2" Padding="18,0"><TextBlock x:Name="StatusText" Text="就绪 · 本地 7-Zip 26.05 引擎" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
 </Grid>
</Window>
